<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_ios_alert"
        android:elevation="@dimen/elevation_fab"
        android:maxWidth="280dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md">

        <TextView
            android:id="@+id/message"
            style="@style/Passwords.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/ios_text" />

        <TextView
            android:id="@+id/btnDelete"
            style="@style/Passwords.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_md"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_ios_alert_btn"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/delete_password"
            android:textColor="@color/ios_alert_destructive" />
    </LinearLayout>
</FrameLayout>
