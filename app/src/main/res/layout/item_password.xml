<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingVertical="@dimen/space_xs">

    <LinearLayout
        android:id="@+id/swipeDelete"
        android:layout_width="76dp"
        android:layout_height="@dimen/row_height"
        android:layout_gravity="end|center_vertical"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingEnd="@dimen/space_sm">

        <ImageView
            android:layout_width="@dimen/touch_sm"
            android:layout_height="@dimen/touch_sm"
            android:background="@drawable/bg_swipe_trash"
            android:contentDescription="@string/delete"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_trash" />

        <TextView
            style="@style/Passwords.LabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:includeFontPadding="false"
            android:text="@string/delete"
            android:textColor="@color/ios_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/foreground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:elevation="@dimen/elevation_card"
        android:focusable="true"
        android:longClickable="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_sm">

            <ImageView
                android:id="@+id/check"
                android:layout_width="@dimen/touch_sm"
                android:layout_height="@dimen/touch_sm"
                android:layout_marginEnd="@dimen/space_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_off"
                android:visibility="gone" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/icon_well"
                android:layout_height="@dimen/icon_well"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Passwords.Favicon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    style="@style/Passwords.ListTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/subtitle"
                    style="@style/Passwords.ListSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <ImageView
                android:id="@+id/warn"
                android:layout_width="@dimen/icon_well"
                android:layout_height="@dimen/icon_well"
                android:layout_marginEnd="@dimen/space_xs"
                android:contentDescription="@null"
                android:padding="@dimen/space_xs"
                android:src="@drawable/ic_warning_circle"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/chevron"
                android:layout_width="@dimen/icon_glyph"
                android:layout_height="@dimen/icon_well"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron" />
        </LinearLayout>

        <View
            android:id="@+id/separator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/transparent"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
