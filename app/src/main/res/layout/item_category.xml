<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/elevation_card"
        android:minHeight="96dp"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/iconWrap"
                android:layout_width="@dimen/icon_well"
                android:layout_height="@dimen/icon_well"
                android:background="@drawable/bg_icon_blue">

                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="@dimen/icon_glyph"
                    android:layout_height="@dimen/icon_glyph"
                    android:layout_gravity="center"
                    android:contentDescription="@null" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/count"
                style="@style/Passwords.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/label"
            style="@style/Passwords.CardLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" />
    </LinearLayout>
</FrameLayout>
