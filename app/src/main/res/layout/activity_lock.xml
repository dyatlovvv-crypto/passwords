<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg_lock">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:background="@color/black"
            android:contentDescription="@null"
            android:padding="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_lock_hero"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Passwords.LockIcon"
            app:strokeColor="@color/black"
            app:strokeWidth="0dp" />

        <TextView
            style="@style/Passwords.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/lock_title"
            android:textColor="@color/ios_text" />

        <TextView
            android:id="@+id/btnUnlock"
            style="@style/Passwords.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_unlock_pill"
            android:elevation="@dimen/elevation_fab"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingVertical="@dimen/space_sm"
            android:text="@string/unlock"
            android:textColor="@color/ios_unlock_text" />
    </LinearLayout>
</FrameLayout>
